cff-version: 1.2.0
message: >
  If you use needle-rs in your work, please cite both this runtime and the
  original Needle model by Cactus Compute.
title: "needle-rs: Pure-Rust + WASM runtime for the Needle tool-calling models"
authors:
  - family-names: Ibrahim
    given-names: Abdalrahman
version: 0.3.0
date-released: 2026-09-18
url: https://github.com/geekgineer/needle-rs
license: MIT
repository-code: https://github.com/geekgineer/needle-rs

references:
  - type: generic
    title: "Needle 2: A 45M-Parameter Foundation Tool-Calling Model for Tiny Devices"
    authors:
      - family-names: Ndubuaku
        given-names: Henry
      - family-names: Mosoyan
        given-names: Karen
      - family-names: Mroz
        given-names: Jakub
